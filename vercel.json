{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/create-vietqr", "dest": "backend/server.js" },
    { "src": "/save-order", "dest": "backend/server.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}